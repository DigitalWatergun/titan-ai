# --- services stack (docker-compose) ---

# What the SearXNG UI uses for its own self-referential URLs.
# Local dev: localhost. Workstation deploy: the host's Tailscale IP.
SEARXNG_BASE_URL=http://localhost:8080/

# Where OpenWebUI looks for an OpenAI-compatible LLM.
# host.docker.internal resolves to the Docker host (works on Mac and on Linux via extra_hosts).
OPENAI_API_BASE_URL=http://host.docker.internal:8001/v1
