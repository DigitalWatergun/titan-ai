Screen {
    background: #0d1117;
    padding: 1 2;
}

#chat-log {
    height: 1fr;
    padding: 1 0;
    border: none;
    background: #0d1117;
    color: #c9d1d9;
    scrollbar-size: 0 0;
}

#body {
    height: 1fr;        /* fills everything above the full-width status bar */
}

#main-area {
    width: 1fr;         /* takes the space the sidebar doesn't */
    height: 100%;
}

StatusBar {
    dock: bottom;       /* full width, below the sidebar + main area */
}

#input-box {
    background: #161b22;
    border-top: none;
    border-right: none;
    border-bottom: none;
    border-left: tall #58a6ff;
    color: #c9d1d9;
    padding: 1 2;
}

#input-box:focus {
    border-top: none;
    border-right: none;
    border-bottom: none;
    border-left: tall #58a6ff;
}

ConfirmScreen {
    background: transparent;
    padding: 0;
}

#confirm-bar {
    background: #0d1117;
    border-top: solid #58a6ff;
    margin-bottom: 2;
}

#confirm-message {
    color: #58a6ff;
}

ConfirmScreen OptionList,
ConfirmScreen OptionList:focus {
    background: transparent;
    background-tint: transparent;
    border: none;
    color: #c9d1d9;
}

ConfirmScreen OptionList > .option-list--option-highlighted,
ConfirmScreen OptionList:focus > .option-list--option-highlighted {
    background: #30373d;
    color: #c9d1d9;
    text-style: bold;
}

CopyCaret{
    background: #58a6ff 60%;
}

ChatPickerScreen {
    align: center middle;
    background: #0d1117;
}

#picker {
    width: 80%;
    max-width: 100;
    height: 80%;
    padding: 1 2;
    border: round #30363d;
    background: #0d1117;
}

#picker-title {
    color: #58a6ff;
    text-style: bold; 
    padding-bottom: 1;
}

#picker-list {
    background: transparent;
    border: none; 
}

#picker-list > ListItem {
    padding: 0 1;
    color: #c9d1d9;
    background: #0d1117;
}

#picker-list > ListItem.-highlight,
#picker-list:focus > ListItem.-highlight {
    background: #30373d;
    color: #c9d1d9;
}
