Screen {
    background: #0d1117;
    padding: 1 2;
}

#chat-log {
    height: 1fr;
    padding: 1 0;
    border: none;
    background: #0d1117;
    color: #c9d1d9;
    scrollbar-size: 0 0;
}

#body {
    height: 1fr;        /* fills everything above the full-width status bar */
}

#main-area {
    width: 1fr;         /* takes the space the sidebar doesn't */
    height: 100%;
}

StatusBar {
    dock: bottom;       /* full width, below the sidebar + main area */
}

#input-box {
    background: #161b22;
    border-top: none;
    border-right: none;
    border-bottom: none;
    border-left: tall #58a6ff;
    color: #c9d1d9;
    padding: 1 2;
}

#input-box:focus {
    border-top: none;
    border-right: none;
    border-bottom: none;
    border-left: tall #58a6ff;
}

#chat-sidebar {
  width: 26;
  height: 100%;
  background: #0d1117;
  border-right: solid #30363d;
  display: none; /* hidden until Ctrl+E */
}

#chat-sidebar-title {
  height: 1;
  padding: 0 1;
  color: #58a6ff;
  text-style: bold;
  background: #0d1117;
}

#chat-list {
  height: 1fr;
  background: #0d1117;
  scrollbar-size: 0 0;
}

#chat-list > ListItem {
  padding: 0 1;
  color: #c9d1d9;
  background: #0d1117;
}

#chat-list > ListItem.-highlight,
#chat-list:focus > ListItem.-highlight {
  background: #30373d;
  color: #c9d1d9;
}

ConfirmScreen {
    background: transparent;
    padding: 0;
}

#confirm-bar {
    background: #0d1117;
    border-top: solid #58a6ff;
    margin-bottom: 2;
}

#confirm-message {
    color: #58a6ff;
}

ConfirmScreen OptionList,
ConfirmScreen OptionList:focus {
    background: transparent;
    background-tint: transparent;
    border: none;
    color: #c9d1d9;
}

ConfirmScreen OptionList > .option-list--option-highlighted,
ConfirmScreen OptionList:focus > .option-list--option-highlighted {
    background: #30373d;
    color: #c9d1d9;
    text-style: bold;
}
